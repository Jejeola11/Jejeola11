{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/[fn].js": {
      "includeFiles": "server/functions/**",
      "maxDuration": 60
    },
    "api/project-media.js": {
      "includeFiles": "start/project-parts.json",
      "maxDuration": 60
    }
  },
  "routes": [
    {
      "src": "/signup/?",
      "dest": "/start/auth/index.html"
    },
    {
      "src": "/login/?",
      "dest": "/atelier-v2/login.html"
    },
    {
      "src": "/terms/?",
      "dest": "/start/auth/terms.html"
    },
    {
      "src": "/privacy/?",
      "dest": "/start/auth/privacy.html"
    },
    {
      "src": "/start/?",
      "dest": "/start/index.html"
    },
    {
      "src": "/server/functions/_ai-video-book-v2\\.js",
      "status": 404,
      "dest": "/atelier-v2/book-unavailable.txt"
    },
    {
      "src": "/",
      "has": [
        {
          "type": "host",
          "value": "fuse-atelier-guide.vercel.app"
        }
      ],
      "dest": "/atelier-site/phone-to-client.html"
    },
    {
      "src": "/",
      "dest": "/atelier-v2/home.html"
    },
    {
      "src": "/studio/?",
      "dest": "/app/studio.html"
    },
    {
      "src": "/app/?",
      "dest": "/app/index.html"
    },
    {
      "src": "/app/studio/?",
      "dest": "/app/studio.html"
    },
    {
      "src": "/credits/?",
      "dest": "/atelier-v2/pricing.html"
    },
    {
      "src": "/pricing/?",
      "dest": "/atelier-v2/first-client-playbook.html"
    },
    {
      "src": "/first-client-playbook/?",
      "dest": "/atelier-v2/first-client-playbook.html"
    },
    {
      "src": "/playbook/?",
      "dest": "/atelier-v2/playbook.html"
    },
    {
      "src": "/atelier/?",
      "dest": "/atelier-site/final.html"
    },
    {
      "src": "/atelier-preview/?",
      "dest": "/atelier-site/final.html"
    },
    {
      "src": "/p/([^/]+)/?",
      "dest": "/api/page-site?slug=$1"
    },
    {
      "src": "/portfolio/?",
      "dest": "/portfolio/index.html"
    },
    {
      "src": "/challenge/?",
      "dest": "/challenge/index.html"
    },
    {
      "handle": "filesystem"
    }
  ],
  "buildCommand": "node -e 'const fs=require('\\''node:fs'\\''),crypto=require('\\''node:crypto'\\'');\nconst dir='\\''atelier-v2/media/academy/'\\'';\nconst parts=Array.from({length:9},(_,i)=>dir+'\\''course-original.part'\\''+i);\nconst video=Buffer.concat(parts.map(p=>fs.readFileSync(p)));\nif(crypto.createHash('\\''sha256'\\'').update(video).digest('\\''hex'\\'')!=='\\''a5f2e7c208aa0af826a7bf74159ba001ac701dcb853de56891ea888db2187100'\\'')throw new Error('\\''Course video integrity check failed'\\'');\nfs.writeFileSync(dir+'\\''course-intro-original.mp4'\\'',video);\nparts.forEach(p=>fs.unlinkSync(p));\n'"
}
