{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/[fn].js": {
      "includeFiles": "server/functions/**",
      "maxDuration": 60
    },
    "api/project-media.js": {
      "includeFiles": "start/project-parts.json",
      "maxDuration": 60
    }
  },
  "routes": [
    {
      "src": "/signup/?",
      "dest": "/start/auth/index.html"
    },
    {
      "src": "/(?:login/?|atelier-v2/login\\.html)",
      "dest": "/start/auth/index.html"
    },
    {
      "src": "/terms/?",
      "dest": "/start/auth/terms.html"
    },
    {
      "src": "/privacy/?",
      "dest": "/start/auth/privacy.html"
    },
    {
      "src": "/start/?",
      "dest": "/start/index.html"
    },
    {
      "src": "/server/functions/_ai-video-book-v2\\.js",
      "status": 404,
      "dest": "/atelier-v2/book-unavailable.txt"
    },
    {
      "src": "/",
      "has": [
        {
          "type": "host",
          "value": "fuse-atelier-guide.vercel.app"
        }
      ],
      "dest": "/atelier-site/phone-to-client.html"
    },
    {
      "src": "/",
      "dest": "/atelier-v2/home.html"
    },
    {
      "src": "/studio/?",
      "dest": "/app/studio.html"
    },
    {
      "src": "/app/?",
      "dest": "/app/index.html"
    },
    {
      "src": "/app/studio/?",
      "dest": "/app/studio.html"
    },
    {
      "src": "/credits/?",
      "dest": "/atelier-v2/pricing.html"
    },
    {
      "src": "/pricing/?",
      "dest": "/atelier-v2/first-client-playbook.html"
    },
    {
      "src": "/first-client-playbook/?",
      "dest": "/atelier-v2/first-client-playbook.html"
    },
    {
      "src": "/playbook/?",
      "dest": "/atelier-v2/playbook.html"
    },
    {
      "src": "/atelier/?",
      "dest": "/atelier-site/final.html"
    },
    {
      "src": "/atelier-preview/?",
      "dest": "/atelier-site/final.html"
    },
    {
      "src": "/p/([^/]+)/?",
      "dest": "/api/page-site?slug=$1"
    },
    {
      "src": "/portfolio/?",
      "dest": "/portfolio/index.html"
    },
    {
      "src": "/challenge/?",
      "dest": "/challenge/index.html"
    },
    {
      "handle": "filesystem"
    }
  ],
  "buildCommand": "node --test tests/credit-policy.test.cjs && cd atelier-v2/media/academy && f=course-intro-upload-1763.mp4 && cat course-upload-part[0-9][0-9] > $f && echo \"e2c9f9a9d1ef3c50569319719ce3ea2937fba18f1348347502c6e315c33caa56  $f\" | sha256sum -c - && rm course-upload-part* course-original.part*",
  "outputDirectory": "."
}
