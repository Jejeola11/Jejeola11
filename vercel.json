{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.js": {
      "includeFiles": "server/functions/**",
      "maxDuration": 60
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "fuse-atelier-studio(?:-ria-d6b9)?\\.vercel\\.app"
        }
      ],
      "status": 308,
      "headers": {
        "Location": "https://fuse-atelier.vercel.app/$1"
      }
    },
    {
      "src": "/api/([A-Za-z0-9_-]+)",
      "dest": "/api/index.js?fn=$1"
    },
    {
      "src": "/",
      "status": 307,
      "headers": {
        "Location": "/app/studio.html"
      }
    },
    {
      "src": "/studio/?",
      "dest": "/app/studio.html"
    },
    {
      "src": "/app/?",
      "dest": "/app/index.html"
    },
    {
      "src": "/app/studio/?",
      "dest": "/app/studio.html"
    },
    {
      "src": "/atelier/?",
      "dest": "/atelier-site/index.html"
    },
    {
      "handle": "filesystem"
    }
  ]
}
