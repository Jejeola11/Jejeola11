{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/[fn].js": {
      "includeFiles": "server/functions/**",
      "maxDuration": 60
    }
  },
  "routes": [
    {
      "src": "/",
      "status": 307,
      "headers": {
        "Location": "/app/studio.html"
      }
    },
    {
      "src": "/studio/?",
      "dest": "/app/studio.html"
    },
    {
      "src": "/app/?",
      "dest": "/app/index.html"
    },
    {
      "src": "/app/studio/?",
      "dest": "/app/studio.html"
    },
    {
      "src": "/pricing/?",
      "dest": "/atelier-v2/pricing.html"
    },
    {
      "src": "/first-client-playbook/?",
      "dest": "/atelier-v2/first-client-playbook.html"
    },
    {
      "src": "/atelier/?",
      "dest": "/atelier-site/final.html"
    },
    {
      "src": "/atelier-preview/?",
      "dest": "/atelier-site/final.html"
    },
    {
      "src": "/p/([^/]+)/?",
      "dest": "/api/page-site?slug=$1"
    },
    {
      "handle": "filesystem"
    }
  ]
}