{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/[fn].js": { "includeFiles": "server/functions/**", "maxDuration": 60 }
  },
  "routes": [
    { "src": "/", "status": 307, "headers": { "Location": "/app/studio.html" } },
    { "src": "/studio/?", "dest": "/app/studio.html" },
    { "src": "/app/?", "dest": "/app/index.html" },
    { "src": "/app/studio/?", "dest": "/app/studio.html" },
    { "src": "/atelier/?", "dest": "/atelier-site/index.html" },
    { "src": "/class/?", "dest": "/atelier-site/phone-to-client.html" },
    { "src": "/phone-to-client/?", "dest": "/atelier-site/phone-to-client.html" },
    { "handle": "filesystem" }
  ]
}
