# ====== Fuse Studio environment variables ======
# Set these in Netlify → Site settings → Environment variables.
# NEVER commit real values. The frontend only ever sees SUPABASE_URL + SUPABASE_ANON_KEY
# (those two are safe to expose). Everything else is server-only (Netlify Functions).

# --- Supabase (from Supabase dashboard → Project Settings → API) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key   # SERVER ONLY — full DB access

# --- MuAPI (the image/video engine — this is YOUR key now, users never see it) ---
MUAPI_KEY=your-muapi-key

# --- Paystack (Dashboard → Settings → API Keys & Webhooks) ---
PAYSTACK_SECRET_KEY=sk_live_or_test_xxx                   # SERVER ONLY
PAYSTACK_PUBLIC_KEY=pk_live_or_test_xxx                   # safe to expose if needed

# --- App ---
APP_URL=https://your-fuse-studio-site.netlify.app          # used for Paystack callback
